# From https://my.telegram.org/apps

API_ID=123456

API_HASH=xxxxxxxxxxxxxxxxxxxxx

## For non-interactive deploy platforms (Render), set TELEGRAM_SESSION to a
## saved StringSession value from a successful local login.
TELEGRAM_SESSION=



PORT=3000

MONGODB_URI=mongodb://root:changeme@localhost:27017/telegram_offers?authSource=admin



# Initial load on startup: last N messages per channel

SYNC_ON_START=true

SYNC_RECENT_PER_CHANNEL=100



# Poll only messages newer than last saved (never re-fetches all history)

POLL_INTERVAL_SEC=30

POLL_BATCH_SIZE=20

# Save Telegram post images to data/media (recommended)
DOWNLOAD_MEDIA_ON_SYNC=true
DOWNLOAD_MEDIA_ON_POLL=true
TELEGRAM_USE_WSS=true
TELEGRAM_AUTO_RECONNECT=true
TELEGRAM_CONNECTION_RETRIES=20
TELEGRAM_RECONNECT_RETRIES=20
TELEGRAM_REQUEST_RETRIES=10
TELEGRAM_DOWNLOAD_RETRIES=10
TELEGRAM_RETRY_DELAY_MS=1500
TELEGRAM_DOWNLOAD_ATTEMPTS=3
TELEGRAM_LOG_LEVEL=warn



# Full history only when you ask: curl -X POST "http://localhost:3000/sync?full=true"

# Reset database: npm run reset-db



OFFERS_DEFAULT_LIMIT=50

OFFERS_MAX_LIMIT=10000

OFFERS_DEDUPE=true
# Min shared description substring length to treat offers as duplicates
OFFERS_DEDUPE_MIN_SUBSTRING=16
# Max offers scanned for substring dedupe on list/count
OFFERS_DEDUPE_SCAN_LIMIT=10000

# Remove offers older than N days (checked on startup and every hour)

OFFERS_RETENTION_DAYS=5

OFFERS_CLEANUP_ENABLED=true

OFFERS_CLEANUP_INTERVAL_SEC=3600



MONGO_ROOT_USER=root

MONGO_ROOT_PASSWORD=changeme

MONGO_PORT=27017

